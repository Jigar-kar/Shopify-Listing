# ════════════════════════════════════════════════════════════════════════════
# Shopify Bulk Product Lister — Environment Configuration
# ════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it contains sensitive tokens)
#
# ════════════════════════════════════════════════════════════════════════════

# Your Shopify store URL (WITHOUT protocol - just the domain)
# Example: https://mystore.myshopify.com → mystore.myshopify.com
SHOPIFY_STORE_URL=u1ei0c-xw.myshopify.com

# Your Shopify Admin API Access Token
# Get this from: Shopify Admin → Settings → Apps and integrations → Develop apps
# Look for: Admin API access tokens
# Starts with: shpat_
SHOPIFY_ADMIN_TOKEN=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

# Server port (optional, defaults to 3000)
PORT=3000

# Node environment (optional)
# Values: development, production
NODE_ENV=development

# Frontend URL for CORS (optional)
# Use this if your frontend is on a different domain
FRONTEND_URL=*
